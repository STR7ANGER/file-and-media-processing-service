{
  "name": "file-and-media-processing-service",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "go:test": "cd services/upload-coordinator && go test ./...",
    "go:build": "cd services/upload-coordinator && go build ./cmd/server",
    "check": "npm run format:check && npm run typecheck && npm test && npm run go:test",
    "build": "npm run build --workspaces --if-present && npm run go:build",
    "db:validate": "DATABASE_URL=${DATABASE_URL:-postgresql://media:media@localhost:5435/media} prisma validate",
    "db:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://media:media@localhost:5435/media} prisma generate"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prisma": "^6.19.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
